generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"

}

datasource db {
  provider = "postgresql"
}

// 1. СТРОГИЕ СТАТУСЫ ТОВАРА
enum ProductStatus {
  AVAILABLE
  RESERVED
  SOLD
}

// 2. СТАТУСЫ ЗАКАЗА
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  CANCELLED
}

/// ==========================================
// 2. БИЗНЕС-МОДЕЛИ 
// ==========================================
model Product {
  id                 String        @id @default(uuid())
  title              String
  slug               String        @unique
  description        String        @db.Text
  price              Int           
  
  status             ProductStatus @default(AVAILABLE)

  // время, до которого действует бронь.
  // NULL = товар не забронирован (AVAILABLE или SOLD).
  reservedUntil      DateTime?

  thumbnailFront     String
  thumbnailBack      String
  gallery            String[]

  size               String
  materials          String?
  
  sequenceFolder     String        
  sequenceFrameCount Int           @default(174)

  favoriteCount      Int           @default(0)

  categoryId         String
  category           Category      @relation(fields: [categoryId], references: [id])
  
  // orderId            String?
  // order              Order?        @relation(fields: [orderId], references: [id])
  // для истории заказа
  orderItems         OrderItem[]

  // СВЯЗИ ДЛЯ КОРЗИНЫ И ИЗБРАННОГО
  favorites          Favorite[]
  cartItems          CartItem[]

  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([slug])

  // композитный индекс под воркер автоматического снятия брони.
  // Запрос вида: WHERE status = 'RESERVED' AND reservedUntil < now()
  @@index([status, reservedUntil])
}

model Order {
  id               String      @id @default(uuid())
  status           OrderStatus @default(PENDING)
  
  // Данные для гостя
  customerEmail    String?
  customerName     String?
  customerPhone    String?     

  // Данные для доставки
  shippingCountry    String?
  shippingCity       String?
  shippingPostalCode String? // Почтовый индекс
  shippingStreet     String? // Улица, номер дома, квартира
  shippingState      String? // Область, регион
  
  // Гость по куке — для консистентности с Favorite/CartItem
  guestId          String?     // чтобы привязать заказ к гостевой сессии
  // Снимок суммы на момент заказа (цена товара может измениться)
  totalAmount      Int         @default(0)  // в минорных единицах (центы)

  // Связь с авторизованным пользователем
  userId           String?
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  stripeSessionId  String?     @unique
  
  // items            Product[]
  // СТАЛО: Заказ теперь ссылается на строки чека, а не напрямую на товары
  items            OrderItem[]

  expiresAt        DateTime?   

  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([stripeSessionId])
  @@index([userId]) //Индекс для быстрого поиска заказов юзера
  @@index([guestId])          // + NEW
  @@index([status, expiresAt]) // + NEW: для крона, чистящего протухшие PENDING-заказы
}

// история заказов 
model OrderItem {
  id           String   @id @default(uuid())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 1. Связь с заказом (Если удалят заказ, удалятся и его строки)
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // 2. Связь с товаром (Навсегда сохраняет факт участия товара в чеке)
  productId    String
  product      Product  @relation(fields: [productId], references: [id])

  // 3. Финансовый и визуальный "Снимок" на момент нажатия кнопки Оплатить
  priceAtOrder Int
  titleAtOrder String

  @@index([orderId])
  @@index([productId])
}

// Сериализует ПОЛНЫЙ путь createCheckoutSession (включая round-trip к Stripe)
// для одного пользователя. Именно таблица, а не pg_advisory_lock: DATABASE_URL
// работает через PgBouncer в transaction pooling, где сессионный advisory-лок
// не переживает смену физического соединения между двумя запросами, а
// xact-версия жила бы только внутри одной транзакции — тогда как защищать надо
// в том числе вызов Stripe, который длится десятки секунд.
model CheckoutLock {
  userId    String   @id

  // Владелец лока. Без сверки token при DELETE процесс, чей лок протух по TTL
  // и был перехвачен следующим запросом, снял бы чужой АКТИВНЫЙ лок.
  token     String

  expiresAt DateTime

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique 
  slug        String    @unique 
  
  products    Product[] 

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model SiteSettings {
  id                     String   @id @default("global") 
  heroSequenceFolder     String   @default("sequence")
  heroSequenceFrameCount Int      @default(174)
  updatedAt              DateTime @updatedAt
}

// ==========================================
// 3. E-COMMERCE МОДЕЛИ (Гость + Авторизованный)
// ==========================================

model Favorite {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Может принадлежать пользователю
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ИЛИ гостю (по куке)
  guestId   String?

  // Защита от дублей: один юзер/гость может лайкнуть товар только один раз
  @@unique([productId, userId])
  @@unique([productId, guestId])
  
  @@index([guestId])
  @@index([userId])
}

model CartItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  guestId   String?

  // Защита от дублей в корзине
  @@unique([productId, userId])
  @@unique([productId, guestId])

  @@index([guestId])
  @@index([userId])
}

// ==========================================
// 4. BETTER-AUTH МОДЕЛИ 
// ==========================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]

  phone         String?   
  // Данные для доставки
  firstName     String?   
  lastName      String?
  country       String?
  city          String?
  postalCode    String?
  street        String?
  state         String?
  
  //Связи с e-commerce таблицами
  favorites     Favorite[]
  cartItems     CartItem[]
  
  //История заказов пользователя
  orders        Order[]

  //Мьютекс оформления заказа (см. model CheckoutLock)
  checkoutLock  CheckoutLock?

  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}